# Demo app env. Copy to .env.local and fill in the parts you want to test
# end-to-end. Anything missing falls through to a mock or skip.

# Database (Neon / local Postgres)
DATABASE_URL=postgres://...

# Auth (Better Auth) — optional for the demo
BETTER_AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Upstash Redis (rate-limit, idempotency, cache-redis, use-swr-cache)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash (background-jobs, digest-scheduler)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Resend (send-email, all email templates)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@yourdomain.com
RESEND_DEV_PREVIEW=true   # logs payloads instead of sending — recommended for the demo

# S3 / R2 (signed-url, upload-file, data-export)
S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Stripe (stripe-webhook-handler, billing-portal)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Feature flags
FEATURE_NEW_PRICING=true
FEATURE_EXPERIMENTAL_SEARCH=false

# Maintenance toggle (maintenance-mode)
MAINTENANCE_MODE=false
NEXT_PUBLIC_MAINTENANCE_MODE=false
