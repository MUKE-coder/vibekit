# Public site URL — used for canonical URLs, sitemap, OpenGraph
NEXT_PUBLIC_SITE_URL="https://vibekit.desishub.com"

# Stripe — powers the /sponsor "buy me a coffee" checkout. Server-only (NO
# NEXT_PUBLIC_ prefix): it must never reach the browser. Without it, /sponsor
# renders but checkout returns a graceful 500. Use sk_test_… in dev, sk_live_…
# in prod. From the Stripe dashboard › Developers › API keys.
STRIPE_SECRET_KEY="sk_test_..."

# ── Zenith analytics ────────────────────────────────────────────────────────
# NO NEXT_PUBLIC_ prefix on any of these: <Analytics /> renders server-side and
# inlines the site key into the HTML, and the other three must stay server-only.
# Fill real values in .env.local (never commit it) and in the Vercel dashboard.
ZENITH_URL="https://analytics.gritframework.dev"
ZENITH_SITE_KEY="zk_the_public_site_key"    # public write key — from Zenith console › Setup
ZENITH_API_KEY="zk_the_secret_api_key"      # secret read key — server-only, from Zenith console › Setup
ZENITH_PW_HASH="$2b$10$..."                 # bcrypt hash of the dashboard password (npx zenith hash)
ZENITH_JWT_SECRET="..."                     # 32+ chars, signs the dashboard session cookie
