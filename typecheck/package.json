{
  "name": "vibekit-registry-typecheck",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Compiles every registry primitive so type errors surface here instead of in a user's project.",
  "scripts": {
    "gen": "node scripts/gen-tsconfig.mjs",
    "typecheck": "node scripts/gen-tsconfig.mjs && tsc --noEmit",
    "test": "npm run typecheck"
  },
