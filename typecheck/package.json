    "@react-pdf/renderer": "^4.1.0",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-virtual": "^3.11.0",
    "@upstash/qstash": "^2.7.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.0",
    "archiver": "^7.0.1",
    "date-fns": "^4.1.0",
    "isomorphic-dompurify": "^2.19.0",
    "lucide-react": "^0.460.0",
    "next": "16.2.2",
    "next-themes": "^0.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
